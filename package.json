{
  "name": "kimi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @kimi/web dev",
    "dev:api": "bun run --filter @kimi/api dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --filter @kimi/web build",
    "lint": "bun run --filter @kimi/web lint",
    "check": "bun run --filter '*' typecheck"
  },
  "dependencies": {
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
